@model FeriaPro.ViewModels.EvaluacionViewModel
@{ViewData["Title"] = "Evaluar proyecto"; var p = Model.Proyecto!;}
<h1>Evaluar: @p.Titulo</h1><p>@p.Feria.Nombre · @p.Grupo.Nombre</p><p class="descripcion">@p.Descripcion</p>
<div class="row g-4"><div class="col-md-5">@if(p.FotoUrl != null){<img src="@p.FotoUrl" alt="Fotografía de @p.Titulo" class="img-fluid rounded mb-3" />}<a href="@p.PdfUrl" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary">Abrir documento PDF</a><h2 class="h5 mt-4">Integrantes</h2><ul>@foreach(var g in p.Grupo.GrupoEstudiantes){<li>@g.Estudiante.Nombre</li>}</ul></div>
<div class="col-md-7"><form method="post" class="card p-4" id="evaluacion"><input asp-for="TribunalId" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div>
<label asp-for="Innovacion" class="form-label">Innovación (40%)</label><input asp-for="Innovacion" type="number" min="0" max="100" step="0.01" class="form-control mb-3" required />
<label asp-for="DesarrolloTecnico" class="form-label">Desarrollo técnico (40%)</label><input asp-for="DesarrolloTecnico" type="number" min="0" max="100" step="0.01" class="form-control mb-3" required />
<label asp-for="Presentacion" class="form-label">Presentación (20%)</label><input asp-for="Presentacion" type="number" min="0" max="100" step="0.01" class="form-control mb-3" required />
<p class="fs-4">Nota: <output id="nota">—</output> / 100</p><label asp-for="Observaciones" class="form-label">Observaciones</label><textarea asp-for="Observaciones" rows="4" class="form-control mb-3"></textarea><button class="btn btn-primary">Guardar evaluación</button><a asp-action="Index" class="mt-3">Cancelar</a></form></div></div>
