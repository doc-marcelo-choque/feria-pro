@model List<Grupo>
@{ViewData["Title"] = "Grupos";}
<div class="d-flex justify-content-between"><h1>Grupos de trabajo</h1>@if(User.IsInRole(Roles.Estudiante)){<a asp-action="Create" class="btn btn-primary align-self-center">Crear grupo</a>}</div>
<div class="table-responsive"><table class="table"><thead><tr><th>Nombre</th><th>Responsable</th><th>Integrantes</th><th>Creado</th><th></th></tr></thead><tbody>
@foreach(var g in Model){<tr><td>@g.Nombre</td><td>@g.ResponsableEstudiante.Nombre</td><td>@g.GrupoEstudiantes.Count</td><td>@g.FechaCreacion.ToString("dd/MM/yyyy")</td><td><a asp-action="Details" asp-route-id="@g.Id">Ver grupo</a></td></tr>}
</tbody></table></div>
