@model FeriaPro.ViewModels.ProyectoViewModel
@{ViewData["Title"] = Model.Id == 0 ? "Registrar proyecto" : "Editar proyecto";}
<h1>@ViewData["Title"]</h1><form method="post" enctype="multipart/form-data" class="card p-4"><input asp-for="Id" type="hidden" /><div asp-validation-summary="All" class="text-danger"></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="FeriaId" class="form-label">Feria abierta</label><select asp-for="FeriaId" asp-items="ViewBag.Ferias" class="form-select"><option value="">Seleccionar</option></select></div>
<div class="col-md-6"><label asp-for="GrupoId" class="form-label">Grupo</label><select asp-for="GrupoId" asp-items="ViewBag.Grupos" class="form-select"><option value="">Seleccionar</option></select></div></div>
<label asp-for="Titulo" class="form-label mt-3">Título</label><input asp-for="Titulo" class="form-control" />
<label asp-for="Descripcion" class="form-label mt-3">Descripción</label><textarea asp-for="Descripcion" class="form-control" rows="5"></textarea>
<label asp-for="Fotografia" class="form-label mt-3">Fotografía (JPG, PNG o WebP, hasta 5 MB)</label><input asp-for="Fotografia" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
<label asp-for="PdfUrl" class="form-label mt-3">Enlace HTTPS al documento PDF</label><input asp-for="PdfUrl" class="form-control" type="url" placeholder="https://…" />
<div class="mt-3"><button class="btn btn-primary">Guardar proyecto</button> <a asp-action="Index">Cancelar</a></div></form>
