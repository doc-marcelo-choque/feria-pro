@model List<Feria>
@{ViewData["Title"] = "Resultados";}
<h1>Resultados por feria</h1><p>Los resultados oficiales se muestran después de finalizar y publicar cada feria.</p><div class="row g-3">
@foreach(var f in Model){<div class="col-md-6"><div class="card p-4"><h2 class="h4">@f.Nombre</h2><p>@f.FechaFin.ToString("dd/MM/yyyy") · @(f.ResultadosPublicados ? "Resultados oficiales" : "Pendiente de publicación")</p><a asp-action="Details" asp-route-id="@f.Id" class="btn btn-outline-primary">Ver ranking</a></div></div>}</div>
@if(Model.Count == 0){<p>Todavía no hay resultados publicados.</p>}
